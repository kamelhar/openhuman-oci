# VHS tape: records deploy/scripts/demo.sh into media/demo.mp4 (run from the repo root: vhs media/demo.tape)
Output media/demo.mp4
Set Shell bash
Set FontSize 14
Set Width 1600
Set Height 1000
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Set Padding 18
Type "clear && ./deploy/scripts/demo.sh"
Enter
Sleep 170s
