# VHS tape: records deploy/scripts/demo-research.sh into media/demo-research.mp4 (run from the repo root)
Output media/demo-research.mp4
Set Shell bash
Set FontSize 14
Set Width 1600
Set Height 1000
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms
Set Padding 18
Env DEMO_PACE "2"
Type "clear && ./deploy/scripts/demo-research.sh"
Enter
Sleep 300s
